# ============================================================
# RadarSmart BR — Variáveis de Afiliados, Automação e Analytics
# NUNCA commite arquivos .env reais com tokens ou dados pessoais.
# Configure estas variáveis no GitHub Actions (Settings -> Secrets and variables).
# ============================================================

# --- Programas de Afiliados (Pessoa Física / CPF - R$ 0) ---
MAGALU_STORE_SLUG=
AMAZON_PARTNER_TAG=
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_AFFILIATE_ID=
AWIN_AFFILIATE_ID=
AWIN_MID_MOTOROLA=
AWIN_MID_FASTSHOP=
AWIN_MID_TROCAFONE=
AWIN_MID_KABUM=
LOMADEE_SOURCE_ID=

# --- Links diretos /sec/ ou afiliados mapeados manualmente (JSON opcional) ---
# Ex.: {"galaxy-a56-256gb":"https://mercadolivre.com/sec/XXXX"}
ML_AFFILIATE_MAP_JSON=

# --- Automação e Distribuição ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# --- IA Opcional (Gratuito via GitHub Models ou Gemini Free Tier) ---
GITHUB_MODELS_TOKEN=
GEMINI_API_KEY=

# --- Build Público / Analytics ---
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=https://renddre2.github.io/radarsmart-br
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_WEBHOOK_URL=
